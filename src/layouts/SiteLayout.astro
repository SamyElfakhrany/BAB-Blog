---
import '../styles/global.css';
import BrandMark from '../components/BrandMark.astro';
import { brand } from '../lib/brand';
import { getDirection, getLanguage, localizePath, ui, withBase } from '../lib/content';

type Section = 'start' | 'paths' | 'books' | 'case-study' | 'templates' | 'tools' | 'follow' | 'search' | 'about';

interface Props {
  lang?: 'en' | 'ar';
  title?: string;
  description?: string;
  canonicalPath?: string;
  alternatePath?: string;
  image?: string;
  ogType?: 'website' | 'book';
  structuredData?: Record<string, unknown>;
  currentSection?: Section;
}

const {
  lang = 'en', title, description, canonicalPath = `/${lang}/`, alternatePath: exactAlternatePath,
  image, ogType = 'website', structuredData, currentSection
} = Astro.props;
const language = getLanguage(lang);
const strings = ui[language];
const direction = getDirection(language);
const pageTitle = title ? `${title} · ${brand.displayName}` : `${brand.displayName} · ${brand.expansion.en}`;
const pageDescription = description || strings.homeIntro;
const canonical = new URL(withBase(canonicalPath), Astro.site || Astro.url).href;
const alternateLang = language === 'en' ? 'ar' : 'en';
const alternatePath = exactAlternatePath || localizePath(canonicalPath, alternateLang);
const socialImage = image || brand.assets.socialCard;
const navigation: Array<{ id: Section; label: string; href: string }> = [
  { id: 'start', label: strings.navLearn, href: `/${language}/` },
  { id: 'paths', label: strings.navPaths, href: `/${language}/learning-paths/` },
  { id: 'books', label: strings.navBooks, href: `/${language}/books/` },
  { id: 'case-study', label: strings.navCaseStudy, href: `/${language}/case-study/` },
  { id: 'templates', label: strings.navTemplates, href: `/${language}/templates/` },
  { id: 'tools', label: strings.navTools, href: `/${language}/tools/` },
  { id: 'follow', label: strings.navFollow, href: `/${language}/follow/` }
];
---
<!doctype html>
<html lang={language} dir={direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={language} href={canonical} />
    <link rel="alternate" hreflang={alternateLang} href={new URL(withBase(alternatePath), Astro.site || Astro.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(withBase('/en/'), Astro.site || Astro.url).href} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase(socialImage), Astro.site || Astro.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${brand.displayName} — ${brand.tagline[language]}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={new URL(withBase(socialImage), Astro.site || Astro.url).href} />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/brand/favicon-32x32.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/brand/apple-touch-icon.png')} />
    <title>{pageTitle}</title>
    <script is:inline>document.documentElement.classList.add('has-js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{strings.skipToContent}</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={withBase(`/${language}/`)} aria-label={`${strings.siteName} ${strings.navLearn}`}>
          <BrandMark lang={language} />
        </a>
        <nav class="main-nav" aria-label={strings.mainNavigation}>
          {navigation.map((item) => <a href={withBase(item.href)} aria-current={currentSection === item.id ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <div class="header-actions">
          <a class="language-switch" href={withBase(alternatePath)} hreflang={alternateLang}>{strings.language}</a>
          <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label={strings.menu} data-open-label={strings.menu} data-close-label={strings.closeMenu}>{strings.menu}</button>
        </div>
      </div>
      <nav id="mobile-nav" class="mobile-nav shell" aria-label={strings.mobileNavigation} hidden>
        {navigation.map((item) => <a href={withBase(item.href)} aria-current={currentSection === item.id ? 'page' : undefined}>{item.label}</a>)}
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <BrandMark lang={language} inverse />
        <p>{brand.supportingLine[language]}</p>
        <a href={withBase(`/${language}/learning-paths/`)}>{strings.navPaths}</a>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#mobile-nav');
      const setOpen = (open: boolean) => {
        if (!toggle || !nav) return;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? toggle.dataset.closeLabel || '' : toggle.dataset.openLabel || '');
        toggle.textContent = open ? toggle.dataset.closeLabel || '' : toggle.dataset.openLabel || '';
        nav.hidden = !open;
      };
      toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') { setOpen(false); toggle?.focus(); } });
    </script>
  </body>
</html>
