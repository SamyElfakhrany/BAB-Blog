---
import '../styles/global.css';
import { getDirection, getLanguage, localizePath, ui, withBase } from '../lib/content';

interface Props {
  lang?: 'en' | 'ar';
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
}

const { lang = 'en', title, description, canonicalPath = `/${lang}/`, image } = Astro.props;
const language = getLanguage(lang);
const strings = ui[language];
const direction = getDirection(language);
const pageTitle = title ? `${title} · BAC9` : 'BAC9 · Business Analysis Bootcamp';
const pageDescription = description || strings.homeIntro;
const canonical = new URL(withBase(canonicalPath), Astro.site || Astro.url).href;
const alternateLang = language === 'en' ? 'ar' : 'en';
const alternatePath = localizePath(canonicalPath, alternateLang);
---
<!doctype html>
<html lang={language} dir={direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={language} href={canonical} />
    <link rel="alternate" hreflang={alternateLang} href={new URL(withBase(alternatePath), Astro.site || Astro.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(withBase('/en/'), Astro.site || Astro.url).href} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(withBase(image), Astro.site || Astro.url).href} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={withBase(`/${language}/`)} aria-label={`${strings.siteName} home`}>
          <span class="brand-mark">B9</span>
          <span class="brand-copy"><strong>{strings.siteName}</strong><small>{strings.siteLabel}</small></span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          <a href={withBase(`/${language}/`)}>{strings.navLearn}</a>
          <a href={withBase(`/${language}/case-study/`)}>{strings.navCaseStudy}</a>
          <a href={withBase(`/${language}/templates/`)}>{strings.navTemplates}</a>
          <a href={withBase(`/${language}/about/`)}>{strings.navAbout}</a>
        </nav>
        <div class="header-actions">
          <a class="language-switch" href={withBase(alternatePath)}>{strings.language}</a>
          <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">Menu</button>
        </div>
      </div>
      <nav id="mobile-nav" class="mobile-nav shell" aria-label="Mobile navigation">
        <a href={withBase(`/${language}/`)}>{strings.navLearn}</a>
        <a href={withBase(`/${language}/case-study/`)}>{strings.navCaseStudy}</a>
        <a href={withBase(`/${language}/templates/`)}>{strings.navTemplates}</a>
        <a href={withBase(`/${language}/about/`)}>{strings.navAbout}</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <div><strong>BAC9</strong><span>{strings.siteLabel}</span></div>
        <p>{language === 'en' ? 'Practical analysis, technical fluency, responsible AI.' : 'تحليل عملي، وفهم تقني، وذكاء اصطناعي مسؤول.'}</p>
        <a href={withBase(`/${language}/about/`)}>{strings.navAbout}</a>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('#mobile-nav');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('is-open', !open);
      });
    </script>
  </body>
</html>
