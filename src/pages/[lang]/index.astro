---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import TutorialCard from '../../components/TutorialCard.astro';
import SearchBox from '../../components/SearchBox.astro';
import { categoryDescriptions, categoryLabels, getLanguage, ui, withBase } from '../../lib/content';

export async function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'ar' } }];
}

const lang = getLanguage(Astro.params.lang || 'en');
const strings = ui[lang];
const all = (await getCollection('tutorials', ({ data }) => data.lang === lang && !data.draft)).sort((a, b) => a.data.published.valueOf() - b.data.published.valueOf());
const featured = all.slice(-3).reverse();
---
<SiteLayout lang={lang} title={strings.siteLabel} description={strings.homeIntro}>
  <section class="home-hero shell">
    <div class="hero-copy">
      <span class="eyebrow">Business Analysis Bootcamp · BAC9</span>
      <h1>{lang === 'en' ? 'Build the BA muscle for real work.' : 'ابنِ مهارات محلل الأعمال للعمل الحقيقي.'}</h1>
      <p>{strings.homeIntro}</p>
      <div class="hero-actions"><a class="button button-primary" href={withBase(`/${lang}/business/`)}>{strings.featured} <span aria-hidden="true">↗</span></a><a class="button button-quiet" href={withBase(`/${lang}/case-study/`)}>{strings.navCaseStudy}</a></div>
    </div>
    <div class="hero-note">
      <div class="note-number">01</div>
      <p>{lang === 'en' ? 'One case study. Clear concepts. Useful artifacts.' : 'دراسة حالة واحدة. مفاهيم واضحة. مخرجات مفيدة.'}</p>
      <div class="note-line"></div>
      <span>{lang === 'en' ? 'Learn → apply → discuss' : 'تعلّم ← طبّق ← ناقش'}</span>
    </div>
  </section>

  <section class="path-section shell" aria-labelledby="paths-title">
    <div class="section-heading"><div><span class="eyebrow">{lang === 'en' ? 'Three paths' : 'ثلاثة مسارات'}</span><h2 id="paths-title">{lang === 'en' ? 'A connected way to learn.' : 'طريقة مترابطة للتعلّم.'}</h2></div><p>{strings.caseStudyIntro}</p></div>
    <div class="path-grid">
      {(['business', 'technical', 'ai'] as const).map((category, index) => (
        <a class={`path-card path-${category}`} href={withBase(`/${lang}/${category}/`)}>
          <span class="path-index">0{index + 1}</span><span class="path-kicker">{category === 'business' ? 'THINK' : category === 'technical' ? 'COLLABORATE' : 'MULTIPLY'}</span>
          <h3>{categoryLabels[category][lang]}</h3><p>{categoryDescriptions[category][lang]}</p><span class="path-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="tutorial-section shell" aria-labelledby="featured-title">
    <div class="section-heading"><div><span class="eyebrow">{strings.featured}</span><h2 id="featured-title">{lang === 'en' ? 'Start with a practical question.' : 'ابدأ بسؤال عملي.'}</h2></div><a class="text-link" href={withBase(`/${lang}/business/`)}>{strings.allTutorials} <span aria-hidden="true">↗</span></a></div>
    <div class="tutorial-grid">{featured.map((entry) => <TutorialCard entry={entry} lang={lang} />)}</div>
  </section>

  <section class="case-study-band shell">
    <div class="case-study-content"><span class="eyebrow">{strings.navCaseStudy}</span><h2>{lang === 'en' ? 'Follow one online-shopping app from idea to delivery.' : 'تابع تطبيق تسوق أونلاين من الفكرة إلى التسليم.'}</h2><p>{strings.caseStudyIntro}</p><a class="text-link" href={withBase(`/${lang}/case-study/`)}>{lang === 'en' ? 'Explore the case study' : 'استكشف دراسة الحالة'} <span aria-hidden="true">↗</span></a></div>
    <div class="case-study-diagram"><div class="diagram-node">Customer need</div><span>→</span><div class="diagram-node diagram-node-accent">BA decision</div><span>→</span><div class="diagram-node">Team delivery</div></div>
  </section>

  <section class="search-section shell"><SearchBox lang={lang} /></section>
</SiteLayout>
