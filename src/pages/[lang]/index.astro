---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ContinueLearning from '../../components/ContinueLearning.astro';
import CurriculumList from '../../components/CurriculumList.astro';
import LearningPathCard from '../../components/LearningPathCard.astro';
import LearningProgressData from '../../components/LearningProgressData.astro';
import SearchBox from '../../components/SearchBox.astro';
import BookCard from '../../components/BookCard.astro';
import { getLanguage, ui, withBase } from '../../lib/content';
import { getJourneyEntries, getPathEntries, pathDefinitions, pathOrder } from '../../lib/curriculum';

export async function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'ar' } }];
}

const lang = getLanguage(Astro.params.lang || 'en');
const strings = ui[lang];
const all = await getCollection('tutorials', ({ data }) => !data.draft);
const books = (await getCollection('books', ({ data }) => data.lang === lang && !data.draft))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
const journey = getJourneyEntries(all, lang);
const firstLesson = journey[0];
const recommended = journey.slice(0, 3);
---
<SiteLayout lang={lang} title={strings.siteLabel} description={strings.homeIntro} currentSection="start">
  <section class="home-hero shell">
    <div class="hero-copy">
      <span class="eyebrow">BAC9 · {strings.siteLabel}</span>
      <h1>{lang === 'en' ? 'Learn Business Analysis, step by step.' : 'اتعلّم تحليل الأعمال خطوة بخطوة.'}</h1>
      <p>{lang === 'en'
        ? 'Follow a practical journey through business foundations, technical fluency, product design, and responsible AI—built for beginner Business Analysts.'
        : 'امشِ في رحلة عملية من أساسيات تحليل الأعمال للفهم التقني وتصميم المنتجات والاستخدام المسؤول للذكاء الاصطناعي—مصممة للمبتدئين.'}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={withBase(`/${lang}/business/who-is-a-business-analyst/`)}>{pathDefinitions.business.copy[lang].action} <span class="direction-icon" aria-hidden="true">→</span></a>
        <a class="button button-quiet" href={withBase(`/${lang}/learning-paths/`)}>{lang === 'en' ? 'Explore the learning roadmap' : 'استكشف خريطة التعلّم'}</a>
      </div>
    </div>
    <div class="journey-summary" aria-label={lang === 'en' ? 'Learning journey summary' : 'ملخص رحلة التعلّم'}>
      <strong>{journey.length}</strong>
      <span>{strings.lessons}</span>
      <div></div>
      <strong>{journey.reduce((total, entry) => total + entry.data.readTime, 0)}</strong>
      <span>{strings.minutes}</span>
      <p>{lang === 'en' ? 'One case study connects every stage.' : 'دراسة حالة واحدة بتربط كل المراحل.'}</p>
    </div>
  </section>

  {firstLesson && <div class="shell continue-section"><ContinueLearning lang={lang} firstLesson={firstLesson} allEntries={all} /></div>}

  <section class="path-section shell" aria-labelledby="paths-title">
    <div class="section-heading">
      <div><span class="eyebrow">{strings.navPaths}</span><h2 id="paths-title">{lang === 'en' ? 'One journey. Four connected stages.' : 'رحلة واحدة. أربع مراحل مترابطة.'}</h2></div>
      <p>{lang === 'en' ? 'Start with the BA role, build technical confidence, learn to review product experiences, then add AI responsibly.' : 'ابدأ بدور الـBA، وابنِ فهمك التقني، واتعلّم تراجع تجربة المنتج، وبعدها استخدم الـAI بمسؤولية.'}</p>
    </div>
    <div class="learning-path-grid">
      {pathOrder.map((category) => <LearningPathCard category={category} entries={getPathEntries(journey, category, lang)} lang={lang} />)}
    </div>
    <div class="roadmap-link-row"><a class="button button-quiet" href={withBase(`/${lang}/learning-paths/`)}>{lang === 'en' ? 'See the complete roadmap' : 'شوف خريطة التعلّم كاملة'}</a></div>
  </section>

  {books.length > 0 && (
    <section class="featured-books-section shell" aria-labelledby="featured-books-title">
      <div class="section-heading">
        <div><span class="eyebrow">{strings.navBooks}</span><h2 id="featured-books-title">{lang === 'en' ? 'Go deeper with a source-grounded book summary.' : 'اتعمّق مع ملخص كتاب مبني على المصدر.'}</h2></div>
        <p>{lang === 'en' ? 'Read the book information, original exercises, visual references, and detailed section-by-section summary.' : 'اقرأ بيانات الكتاب وتمارينه الأصلية ومراجعه البصرية وملخصه التفصيلي قسمًا بقسم.'}</p>
      </div>
      <div class="featured-book-list">{books.slice(0, 1).map((book) => <BookCard entry={book} lang={lang} featured />)}</div>
      <div class="roadmap-link-row"><a class="button button-quiet" href={withBase(`/${lang}/books/`)}>{lang === 'en' ? 'Explore all books' : 'استكشف كل الكتب'}</a></div>
    </section>
  )}

  <section class="how-section">
    <div class="shell">
      <div class="section-heading"><div><span class="eyebrow">{lang === 'en' ? 'How BAC9 works' : 'إزاي تتعلّم مع BAC9'}</span><h2>{lang === 'en' ? 'Turn each idea into something you can use.' : 'حوّل كل فكرة لحاجة تقدر تستخدمها.'}</h2></div></div>
      <ol class="learning-loop">
        <li><span>01</span><strong>{lang === 'en' ? 'Learn' : 'اتعلّم'}</strong><p>{lang === 'en' ? 'Understand the idea in plain language.' : 'افهم الفكرة بلغة بسيطة.'}</p></li>
        <li><span>02</span><strong>{lang === 'en' ? 'See an example' : 'شوف مثال'}</strong><p>{lang === 'en' ? 'Follow the shared online-shopping case.' : 'تابع مثال التسوق الأونلاين المشترك.'}</p></li>
        <li><span>03</span><strong>{lang === 'en' ? 'Apply it' : 'طبّقها'}</strong><p>{lang === 'en' ? 'Practice the BA questions and decisions.' : 'جرّب أسئلة وقرارات محلل الأعمال.'}</p></li>
        <li><span>04</span><strong>{lang === 'en' ? 'Use the artifact' : 'استخدم المخرج'}</strong><p>{lang === 'en' ? 'Adapt a checklist or template to your work.' : 'عدّل Checklist أو Template يناسب شغلك.'}</p></li>
      </ol>
      <div class="inline-actions"><a class="text-link" href={withBase(`/${lang}/case-study/`)}>{strings.navCaseStudy}</a><a class="text-link" href={withBase(`/${lang}/templates/`)}>{strings.navTemplates}</a></div>
    </div>
  </section>

  <section class="curriculum-section shell" aria-labelledby="recommended-title">
    <div class="section-heading"><div><span class="eyebrow">{lang === 'en' ? 'Recommended first lessons' : 'الدروس المقترحة للبداية'}</span><h2 id="recommended-title">{lang === 'en' ? 'Build your foundation in this order.' : 'ابنِ الأساس بالترتيب ده.'}</h2></div></div>
    <CurriculumList entries={recommended} lang={lang} labelledby="recommended-title" />
  </section>

  <section class="search-section shell"><SearchBox lang={lang} /></section>
  <LearningProgressData entries={all} lang={lang} />
</SiteLayout>
