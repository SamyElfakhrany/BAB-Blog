---
import { brand } from '../lib/brand';
import { withBase } from '../lib/content';

interface Props {
  variant?: 'compact' | 'full' | 'symbol';
  tone?: 'color' | 'reverse';
  responsive?: boolean;
  class?: string;
}

const {
  variant = 'compact',
  tone = 'color',
  responsive = false,
  class: className
} = Astro.props;

const sources = {
  compact: tone === 'reverse' ? brand.assets.compactReverse : brand.assets.compactColor,
  full: tone === 'reverse' ? brand.assets.fullReverse : brand.assets.fullColor,
  symbol: tone === 'reverse' ? brand.assets.symbolReverse : brand.assets.symbolColor
};
const alt = `${brand.displayName} — ${brand.expansion.en}`;
---
<span class:list={['brand-identity', `brand-identity--${variant}`, `brand-identity--${tone}`, className]}>
  <picture>
    {responsive && variant === 'compact' && <source media="(max-width: 420px)" srcset={withBase(sources.symbol)} />}
    {responsive && variant === 'full' && <source media="(max-width: 359px)" srcset={withBase(sources.compact)} />}
    <img class:list={['brand-logo', `brand-logo--${variant}`]} src={withBase(sources[variant])} alt={alt} />
  </picture>
</span>

