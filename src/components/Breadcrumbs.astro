---
import type { Language } from '../lib/content';
import { withBase } from '../lib/content';

interface Item { label: string; href?: string; }
interface Props { lang: Language; items: Item[]; }
const { lang, items } = Astro.props;
---
<nav class="breadcrumbs" aria-label={lang === 'en' ? 'Breadcrumbs' : 'مسار التنقل'}>
  <ol>
    {items.map((item, index) => (
      <li>
        {item.href && index < items.length - 1
          ? <a href={withBase(item.href)}>{item.label}</a>
          : <span aria-current="page">{item.label}</span>}
      </li>
    ))}
  </ol>
</nav>
