---
import type { Language, Tutorial } from '../lib/content';
import { getEntryUrl, ui, withBase } from '../lib/content';
import { getLessonPosition, pathDefinitions } from '../lib/curriculum';
import ProgressBar from './ProgressBar.astro';
interface Props { lang: Language; firstLesson: Tutorial; allEntries: Tutorial[]; }
const { lang, firstLesson, allEntries } = Astro.props;
const strings = ui[lang];
const position = getLessonPosition(firstLesson, allEntries);
---
<section class="continue-panel" data-continue-panel aria-labelledby="continue-title">
  <div class="continue-copy">
    <span class="eyebrow" data-continue-eyebrow>{lang === 'en' ? 'Your next step' : 'خطوتك التالية'}</span>
    <h2 id="continue-title" data-continue-heading>{lang === 'en' ? 'New here? Start with the BA role.' : 'أول مرة هنا؟ ابدأ بدور محلل الأعمال.'}</h2>
    <p data-continue-meta>{pathDefinitions[firstLesson.data.category].copy[lang].title} · {strings.lesson} {position.step} {strings.of} {position.total}</p>
  </div>
  <div class="continue-action">
    <ProgressBar lang={lang} path={firstLesson.data.category} compact />
    <a class="button button-primary" data-continue-link href={withBase(getEntryUrl(firstLesson))}>{lang === 'en' ? 'Start the first lesson' : 'ابدأ أول درس'}</a>
  </div>
</section>
